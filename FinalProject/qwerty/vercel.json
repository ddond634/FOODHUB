{
  "version": 2,
  "name": "foodhub-frontend",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": ".vercel_build_output/static" } }
  ],
  "routes": [
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "src": "^/favicon.ico$", "dest": "/frontend/favicon.ico" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" },
    { "src": "^/(.*)$", "dest": "/frontend/index.html" }
  ],
  "cleanUrls": true
}
